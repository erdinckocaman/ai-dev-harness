# Read by the kit scripts. One KEY=value per line, no quotes; never sourced.
SOURCE_REPO=~/src/orders-service
SERVICE_NAME=orders
SERVICE_PORT=8080
CONTAINER_MODULE=orders-container
MAIN_CLASS=OrdersApplication
HELM_CHART=orders
ROOT_ARTIFACT_ID=orders-service
DEFAULT_BRANCH=develop
# Optional: FILE_HEADER=file-header.txt turns on the file header check of check.sh.
